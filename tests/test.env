# Test configuration, used only by tests/run.sh: reserved ".test" names (RFC 6761) that the test
# machine's own DNS resolver serves, so the tests depend on nobody's real domains.
source "$(dirname "${BASH_SOURCE[0]}")/../config/mailserver.env.example"
MAIL_HOSTNAME=mail.example.test
PRIMARY_DOMAIN=example.test
PUBLIC_IPV4=192.0.2.10
PUBLIC_IPV6=fd00:5e57::10
ADMIN_EMAIL=alice@example.test
BACKUP_REPOSITORY=/var/tmp/restic-test-repo
