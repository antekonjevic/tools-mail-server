# Copy to /etc/mailserver/secrets.env on the server (owner root, mode 600).
# Keep a copy of every value in your password manager: without RESTIC_PASSWORD the backups cannot be read.

# Encryption password for the backups. Generate with: openssl rand -base64 32
RESTIC_PASSWORD=

# For an S3 repository (s3:...): an access key that can reach only the backup bucket.
# Other restic backends use their own variables instead; see https://restic.readthedocs.io
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
