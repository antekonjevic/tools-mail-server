# Mail server settings. Copy this file to config/mailserver.env and edit it:
#     cp config/mailserver.env.example config/mailserver.env
# Nothing in it is secret, but it describes your server, so config/mailserver.env is git-ignored.
# Secrets live only on the server, in /etc/mailserver/secrets.env.
# The scripts refuse the example values below and other example names (example.com/.org/.net,
# 203.0.113.x, 2001:db8::), so a copy that hasn't been edited can't be installed by mistake.

# The server's own name and public addresses. The name needs an A/AAAA record, and the
# addresses need reverse DNS (PTR) pointing back to it, set at your hosting provider.
# PUBLIC_IPV6 is optional: leave it empty if the server has no public IPv6 address.
MAIL_HOSTNAME=mail.example.com
PRIMARY_DOMAIN=example.com
PUBLIC_IPV4=203.0.113.10
PUBLIC_IPV6=2001:db8::10

# Receives mail addressed to root and other system mail (cron output, Postfix notices).
# Create this mailbox right after installing (mailctl add-mailbox).
ADMIN_EMAIL=me@example.com

# Let's Encrypt account email. Optional; leave empty to register without one.
ACME_EMAIL=

# DKIM selector given to newly added domains, e.g. "s" + year + month. To rotate keys, see docs/runbook.md.
DKIM_SELECTOR=s202601

# MTA-STS policy. Start in "testing"; switch to "enforce" after 2–4 weeks of clean TLS reports.
# Change MTA_STS_ID (e.g. to today's date) every time the policy changes, then update the _mta-sts DNS records.
MTA_STS_MODE=testing
MTA_STS_ID=20260101

# Largest message accepted, in bytes (50 MB)
MESSAGE_SIZE_LIMIT=52428800

# Backups (restic). Any restic repository works, e.g.
#   s3:s3.eu-central-1.amazonaws.com/<bucket>/mailserver   (AWS S3)
#   s3:<endpoint>/<bucket>/mailserver                       (other S3-compatible storage)
#   sftp:user@backup-host:/srv/restic/mailserver
# Credentials go in /etc/mailserver/secrets.env on the server.
BACKUP_REPOSITORY=s3:s3.eu-central-1.amazonaws.com/CHANGE-ME-bucket-name/mailserver
BACKUP_TIME=03:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Automatic security updates reboot at this time (UTC), only when an update requires it
REBOOT_TIME=04:30

# Monitoring thresholds
DISK_ALERT_PERCENT=80
QUEUE_ALERT_COUNT=20
QUEUE_ALERT_AGE_MINUTES=60
CERT_ALERT_DAYS=14
BACKUP_ALERT_HOURS=26
