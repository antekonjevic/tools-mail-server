# Copy to /etc/mailserver/alerts.env on the server (owner root, mode 600).
# Test with: mailctl test-alert

# Channels to use, separated by spaces. Any of: ntfy telegram email webhook
ALERT_CHANNELS="ntfy"

# ntfy (https://ntfy.sh or your own ntfy server). Anyone who knows the topic can read the
# alerts, so use a long random one, e.g.: openssl rand -hex 16
NTFY_URL="https://ntfy.sh/CHANGE-ME-long-random-topic"
NTFY_TOKEN=""

# Telegram: create a bot with @BotFather, then send it a message and look up your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email to an address outside this server. Sent through this server's own Postfix, so it
# cannot report Postfix being down: pair it with another channel, or accept that gap knowingly.
# A new server's first mails often land in spam: at the receiving address, add a filter that
# never sends mail from root@<MAIL_HOSTNAME> to spam.
ALERT_EMAIL_TO=""

# Generic webhook: receives a JSON POST {"title": ..., "message": ..., "host": ...}
WEBHOOK_URL=""

# Optional heartbeat URL (e.g. a healthchecks.io check), called every 5 minutes.
# The external service alerts you when the calls stop, which covers the server being down.
# Instead, or as well, any outside uptime monitor can fetch
# https://mta-sts.<your domain>/.well-known/mta-sts.txt (see docs/runbook.md, step 9).
HEARTBEAT_URL=""
