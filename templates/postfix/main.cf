# Postfix main configuration.
# Managed by the mailserver scripts: edit templates/postfix/main.cf in the repo and re-run
# scripts/10-install-mail.sh. Changes made directly here are overwritten.

compatibility_level = 3.10

# ---- Identity
myhostname = ${MAIL_HOSTNAME}
mydomain = ${PRIMARY_DOMAIN}
myorigin = $myhostname
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no

# Local delivery only for system mail (root, postmaster…); /etc/aliases forwards it to a mailbox.
mydestination = $myhostname, localhost
local_recipient_maps = $alias_maps
# (newaliases does not expand $default_database_type, so the type is spelled out)
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mynetworks = 127.0.0.0/8 [::1]/128

# ---- Network
inet_interfaces = all
# "all" when PUBLIC_IPV6 is set, "ipv4" when the server has no IPv6
inet_protocols = ${INET_PROTOCOLS}
# Send from IPv4 first: a missing IPv6 reverse DNS (PTR) is a common reason for rejected mail.
smtp_address_preference = ipv4

# ---- Hosted domains and mailboxes (files generated by "mailctl apply" from /etc/mailserver)
virtual_mailbox_domains = texthash:/etc/postfix/vmail_domains
virtual_mailbox_maps = texthash:/etc/postfix/vmail_mailboxes
virtual_alias_maps = texthash:/etc/postfix/virtual_aliases
virtual_transport = lmtp:unix:private/dovecot-lmtp
recipient_delimiter = +
message_size_limit = ${MESSAGE_SIZE_LIMIT}
mailbox_size_limit = 0

# ---- TLS when receiving (port 25: offered; port 465: required, see master.cf)
smtpd_tls_cert_file = /etc/letsencrypt/live/${MAIL_HOSTNAME}/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/${MAIL_HOSTNAME}/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
# Ciphers on both ports: the shared policy (scripts/lib/common.sh), server's order first.
# Postfix's own defaults also accept anonymous and CBC ciphers and weak Diffie-Hellman.
# @SECLEVEL=2 restores OpenSSL's normal security level, which Postfix lowers: without it, the
# key exchange may still be signed with SHA1.
tls_high_cipherlist = ${TLS_CIPHERS}:@SECLEVEL=2
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high
tls_preempt_cipherlist = yes
# Key exchange over elliptic curves only (Postfix's default curves); no finite-field Diffie-Hellman
tls_ffdhe_auto_groups =

# ---- TLS when sending (used whenever the receiving server supports it)
smtp_tls_security_level = may
smtp_tls_CApath = /etc/ssl/certs
smtp_tls_protocols = >=TLSv1.2
smtp_tls_note_starttls_offer = yes
smtp_tls_loglevel = 1

# ---- Login for sending (checked by Dovecot; enabled only on port 465 in master.cf)
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
# Which login may send from which address (generated by "mailctl apply")
smtpd_sender_login_maps = texthash:/etc/postfix/sender_login

# ---- Rules for mail arriving on port 25
smtpd_helo_required = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_unknown_sender_domain
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unauth_pipelining
smtpd_data_restrictions = reject_unauth_pipelining

# ---- Rspamd: spam filtering and DKIM signing
# If Rspamd is down, mail is deferred (senders retry) rather than passed unfiltered or unsigned.
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
