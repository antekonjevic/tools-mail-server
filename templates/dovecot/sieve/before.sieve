# Runs on every delivered message, before any personal rules.
# Generated by "mailctl apply", which fills in reports@ of every hosted domain below.
require ["fileinto", "mailbox"];

# Marked as spam by Rspamd
if anyof (header :is "X-Spam" "Yes",
          header :matches "X-Spam-Status" "Yes*") {
  fileinto :create "Junk";
  stop;
}

# DMARC and TLS reports, sent to reports@ of a hosted domain
if address :is ["to", "cc"] [${REPORT_ADDRESSES}] {
  fileinto :create "Reports";
  stop;
}
